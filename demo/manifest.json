{
    "manifest_version": 3,
    "name": "Simple Google Auth Extension",
    "version": "1.0",
    "description": "A simple Chrome extension with Google Authentication",
    "permissions": [
      "identity",
      "storage",
      "tabs"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Login"
    },
    "background": {
      "service_worker": "background.js"
    },
    "oauth2": {
      "client_id": "999223446706-njipo892q86lv7odthttqri960roduln.apps.googleusercontent.com",
      "scopes": [
        "openid",
        "profile",
        "email"
      ]
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self';"
      }
  }
  